{
	"name": "pi-split-view",
	"version": "1.5.0",
	"engines": {
		"node": ">=18.0.0"
	},
	"description": "Drawers-view TUI extension for the pi coding agent: Messages over the editor, collapsible Thinking and Tool Usage drawers at the bottom, response-only transcript mode",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test test/*.test.ts"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Hugo-W/pi-split-view.git"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"tui",
		"split-view",
		"panels"
	],
	"files": [
		"split-view.ts",
		"helpers.ts",
		"thinking-hud.ts",
		"tool-highlighter.ts",
		"layout-manager.ts",
		"layout-types.ts",
		"layout-drawers.ts",
		"ui-panels-config.ts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"assets/gallery-preview.png"
	],
	"pi": {
		"extensions": [
			"./split-view.ts"
		],
		"image": "https://raw.githubusercontent.com/Hugo-W/pi-split-view/main/assets/gallery-preview.png"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.2.0",
		"@earendil-works/pi-tui": ">=1.2.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"typescript": "^5.6.3"
	},
	"dependencies": {
		"@lumis-sh/lumis": "^0.10.8",
		"@lumis-sh/themes": "^0.4.5",
		"@lumis-sh/wasm-bash": "^0.26.8",
		"@lumis-sh/wasm-diff": "^0.26.7",
		"@lumis-sh/wasm-go": "^0.26.6",
		"@lumis-sh/wasm-javascript": "^0.26.6",
		"@lumis-sh/wasm-json": "^0.26.7",
		"@lumis-sh/wasm-markdown": "^0.26.5",
		"@lumis-sh/wasm-python": "^0.26.7",
		"@lumis-sh/wasm-regex": "^0.26.4",
		"@lumis-sh/wasm-ruby": "^0.26.6",
		"@lumis-sh/wasm-rust": "^0.26.7",
		"@lumis-sh/wasm-typescript": "^0.26.5",
		"@lumis-sh/wasm-yaml": "^0.26.5"
	}
}
